# NS Development · nsdevelopment.lu (Plesk chez Visual Online : nginx devant Apache)
# Préparé le 17/11/2026 avec la refonte v3. Le http → https est déjà fait par Plesk.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.nsdevelopment.lu → nsdevelopment.lu (une seule adresse pour Google)
  RewriteCond %{HTTP_HOST} ^www\.nsdevelopment\.lu$ [NC]
  RewriteRule ^(.*)$ https://nsdevelopment.lu/$1 [R=301,L]
  # /index.html → / (pas deux adresses pour l'accueil)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  # page NSD 360 de travail, remplacée par la page Marketing
  RewriteRule ^nsd-360\.html$ /marketing.html [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  # pages : toujours la dernière version ; fichiers versionnés (?v=) et médias : un mois en cache
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|woff2|webp|avif|png|jpe?g|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>
